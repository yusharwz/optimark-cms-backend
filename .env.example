# ==============================================================================
# Optimark Headless CMS - Backend Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env before starting the server.
#
# QUICK START:
#   1. Set DATABASE_URL with PostgreSQL connection string + ?schema=optimark_cms
#   2. Set JWT_SECRET with a strong random string (e.g. openssl rand -hex 32)
#   3. Set ADMIN_EMAIL & ADMIN_PASSWORD for initial CMS administrator login
#   4. Set Cloudflare R2 credentials for media upload & WebP image storage
# ==============================================================================

# Server Runtime
PORT=3001
NODE_ENV=production

# Database (PostgreSQL with schema isolation)
# Prisma will auto-create tables inside the specified schema on startup.
DATABASE_URL="postgresql://user:password@localhost:5432/optimark_db?schema=optimark_cms"

# JWT Authentication
# Secret key used for signing login tokens. Keep secret in production.
JWT_SECRET="optimark-cms-super-secret-jwt-key-change-in-production-2026"

# Initial Admin Account (Auto-seeded / synced on bootstrap)
ADMIN_EMAIL="admin@optimark.ai"
ADMIN_PASSWORD="ChangeMeAdmin2026!"
ADMIN_NAME="Admin Optimark"

# CORS Configuration
# Comma-separated allowed origins (e.g. "https://cms.optimark.ai,https://optimark.ai").
# Leave unset or empty to allow origin matching request.
CORS_ORIGIN="http://localhost:3002,https://cms.optimark.ai,https://optimark.ai"

# Cloudflare R2 / S3-compatible Object Storage
# Used for storing uploaded article covers, avatars, and inline media assets.
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY="<cloudflare_r2_access_key_id>"
R2_SECRET_KEY="<cloudflare_r2_secret_access_key>"
R2_BUCKET="optimark-cms-media"
R2_PUBLIC_URL="https://media.optimark.ai"

# Landing Page On-Demand Revalidation Webhook
# Triggers instant Next.js ISR cache invalidation when articles/media are updated.
LANDING_PAGE_REVALIDATE_URL="http://localhost:3000/api/revalidate"
REVALIDATE_SECRET="optimark_cms_revalidate_secret_2026"

# Base Site URLs
FRONTEND_URL="http://localhost:3002"
PUBLIC_SITE_URL="https://optimark.ai"
