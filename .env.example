PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://user:password@localhost:5432/erp_db?schema=optimark_cms"

# Cloudflare R2
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY="<access_key>"
R2_SECRET_KEY="<secret_key>"
R2_BUCKET="erp"
R2_PUBLIC_URL="https://file.example.com"

# Base URLs
FRONTEND_URL="http://localhost:3002"
PUBLIC_SITE_URL="https://optimark.ai"
